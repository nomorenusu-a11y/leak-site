# Copy to .env.local and fill in. Never commit .env.local.

# ---------- Supabase CLI ----------
# Personal Access Token (sbp_*) — Supabase 대시보드 > Account > Access Tokens 에서 발급.
# CLI 명령(`supabase link`, `supabase db push` 등) 인증에 사용. 서버/클라이언트 코드에서는 읽지 않음.
SUPABASE_ACCESS_TOKEN=

# ---------- Site (1단계부터 필요) ----------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=상호명
NEXT_PUBLIC_PHONE=01000000000              # 숫자만, tel: 링크용
NEXT_PUBLIC_KAKAO_CHANNEL=                  # https://pf.kakao.com/_xxx 형태

# ---------- Supabase 프로젝트 키 ----------
# Dashboard > Project Settings > API 에서 복사:
#   Project URL   → NEXT_PUBLIC_SUPABASE_URL
#   anon public   → NEXT_PUBLIC_SUPABASE_ANON_KEY
#   service_role  → SUPABASE_SERVICE_ROLE_KEY  (Reveal 후 복사. 절대 브라우저 코드에서 읽지 말 것)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---------- Admin (5단계부터) ----------
ADMIN_PASSWORD=
SESSION_SECRET=                             # openssl rand -hex 32

# ---------- Analytics & SEO ----------
NEXT_PUBLIC_GA_ID=                          # G-XXXXXXXXXX (없으면 GA 로드 안 함)

# 검색콘솔 verification 메타 태그 — server 또는 NEXT_PUBLIC_ 둘 다 동작.
# 새 이름(아래 두 줄) 우선, 기존 NEXT_PUBLIC_* 변수도 fallback으로 인식됨.
GOOGLE_SITE_VERIFICATION=                   # Google Search Console 발급
NAVER_SITE_VERIFICATION=                    # Naver Webmaster Tools 발급
# Deprecated (기존 코드 호환):
# NEXT_PUBLIC_GOOGLE_VERIFICATION=
# NEXT_PUBLIC_NAVER_VERIFICATION=
