# Copy to .env.local and fill in. Never commit .env.local.

# ---------- Supabase CLI ----------
# Personal Access Token (sbp_*) — Supabase 대시보드 > Account > Access Tokens 에서 발급.
# CLI 명령(`supabase link`, `supabase db push` 등) 인증에 사용. 서버/클라이언트 코드에서는 읽지 않음.
SUPABASE_ACCESS_TOKEN=

# ---------- Site / 영업 정보 ----------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=상호명

# 연락처 — 미설정·잘못된 형식이면 해당 CTA 버튼이 자동으로 미렌더 (잘못된 링크 노출 방지).
# phone은 형식 무관하게 숫자만 추출돼 E.164(tel:+82...)로 변환됨.
NEXT_PUBLIC_PHONE=                          # 예: 01012345678 또는 010-1234-5678
NEXT_PUBLIC_KAKAO_CHANNEL_URL=              # 예: https://pf.kakao.com/_xxx
# Deprecated alias (기존 코드 호환, 위 _URL 변수가 우선):
# NEXT_PUBLIC_KAKAO_CHANNEL=

# 영업 카피 (각 변수 빈 값이면 기본값 사용)
NEXT_PUBLIC_SERVICE_AREA=                   # 기본: "서울·경기 일부 지역"
NEXT_PUBLIC_RESPONSE_TIME=                  # 기본: "30분 이내"
NEXT_PUBLIC_EXPERIENCE=                     # 기본: "오랜 경력의"  (TrustPoints 4번째 카드)

# ---------- Supabase 프로젝트 키 ----------
# Dashboard > Project Settings > API 에서 복사:
#   Project URL   → NEXT_PUBLIC_SUPABASE_URL
#   anon public   → NEXT_PUBLIC_SUPABASE_ANON_KEY
#   service_role  → SUPABASE_SERVICE_ROLE_KEY  (Reveal 후 복사. 절대 브라우저 코드에서 읽지 말 것)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---------- Admin (5단계부터) ----------
ADMIN_PASSWORD=
SESSION_SECRET=                             # openssl rand -hex 32

# ---------- Analytics & SEO ----------
NEXT_PUBLIC_GA_ID=                          # G-XXXXXXXXXX (없으면 GA 로드 안 함)

# 검색콘솔 verification 메타 태그 — server 또는 NEXT_PUBLIC_ 둘 다 동작.
# 새 이름(아래 두 줄) 우선, 기존 NEXT_PUBLIC_* 변수도 fallback으로 인식됨.
GOOGLE_SITE_VERIFICATION=                   # Google Search Console 발급
NAVER_SITE_VERIFICATION=                    # Naver Webmaster Tools 발급
# Deprecated (기존 코드 호환):
# NEXT_PUBLIC_GOOGLE_VERIFICATION=
# NEXT_PUBLIC_NAVER_VERIFICATION=
